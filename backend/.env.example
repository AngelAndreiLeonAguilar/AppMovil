# Copia a .env y ajusta. NUNCA subas el .env al repositorio.

# Firma de los JWT: cadena larga y aleatoria (>= 64 caracteres)
BEL_SECRET_KEY=cambia-esta-cadena-por-una-aleatoria-de-64-caracteres

# Duración de tokens (segundos)
BEL_ACCESS_TTL=900
BEL_REFRESH_TTL=2592000

# Límite de intentos de acceso
BEL_LOGIN_MAX_ATTEMPTS=5
BEL_LOGIN_WINDOW=900

# Orígenes permitidos para CORS (separados por coma)
BEL_CORS_ORIGINS=http://localhost:4200

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=becal_user
DB_PASSWORD=cambia-esta-password
DB_NAME=becal_db
